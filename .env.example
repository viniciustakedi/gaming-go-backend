# Copy to .env for local docker-compose overrides. No real secrets belong
# here - Postgres and MiniStack credentials below are throwaway local
# values, and the SQS role keys are generated fresh by the provisioning
# service on every `docker compose up` (see deploy/ministack/provision.sh
# and deploy/ministack/.runtime/app-credentials.env, git-ignored - see
# README.md for the split between that file and test-credentials.env).

POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432

MINISTACK_PORT=4566

SQS_REGION=us-east-1
SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_QUEUE_NAME=wager-transactions-dlq.fifo
SQS_OUTPUT_QUEUE_NAME=wallet-events.fifo
WAGER_TRANSACTIONS_MAX_RECEIVE_COUNT=5

HTTP_PORT=8080
LOG_LEVEL=info
