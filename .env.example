# Copy to .env for local docker-compose overrides. No real secrets belong
# here - Postgres and MiniStack credentials below are throwaway local
# values, and the SQS role keys are generated fresh by the provisioning
# service on every `docker compose up` (see deploy/ministack/provision.sh
# and deploy/ministack/.runtime/app-credentials.env, git-ignored - see
# README.md for the split between that file and test-credentials.env).

POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432

MINISTACK_PORT=4566

SQS_REGION=us-east-1
SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_QUEUE_NAME=wager-transactions-dlq.fifo
SQS_OUTPUT_QUEUE_NAME=wallet-events.fifo
# Used only by deploy/ministack/provision.sh to create the queue RedrivePolicy;
# the Go service does not read this value.
WAGER_TRANSACTIONS_MAX_RECEIVE_COUNT=5
# The gateway publishes WagerTransactionRequested with MessageGroupId equal
# to walletId and MessageDeduplicationId equal to the envelope messageId.
# The consumer deletes only after its inbox+wallet transaction commits.
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_POLL_WAIT=20s
SQS_CONSUMER_CONCURRENCY=10
SQS_CONSUMER_VISIBILITY_TIMEOUT=30s
SQS_CONSUMER_PROCESSING_TIMEOUT=20s
SQS_CONSUMER_RETRY_BASE=1s
SQS_CONSUMER_RETRY_MAX=1m
SQS_CONSUMER_SHUTDOWN_TIMEOUT=30s
SQS_CONSUMER_PROVIDER_ALLOWLIST=provider-a,provider-b

# Durable retry worker for REFUND, ROLLBACK and referenced WIN that arrive
# before their reference. A short lease makes work recoverable by another
# instance after a crash; tests override all values with short durations.
REFERENCE_WORKER_ENABLED=true
REFERENCE_WORKER_POLL_INTERVAL=250ms
REFERENCE_WORKER_LEASE=30s
REFERENCE_WORKER_BATCH_SIZE=10
REFERENCE_WORKER_RETRY_BASE=1s
REFERENCE_WORKER_RETRY_MAX=1m
REFERENCE_WORKER_MAX_ATTEMPTS=10
REFERENCE_WORKER_TTL=24h
REFERENCE_WORKER_SHUTDOWN_TIMEOUT=5s

HTTP_PORT=8080
LOG_LEVEL=info

# Ports for the "multi" Compose profile's three instances (README.md,
# "Múltiplas instâncias") - unused by the single-instance `app` service
# above.
HTTP_PORT_1=8091
HTTP_PORT_2=8092
HTTP_PORT_3=8093

KEYCLOAK_PORT=8081
AUTH_AUDIENCE=wallet-api

# Keycloak realm "wallet" (deploy/keycloak/realm-wallet.json) is imported
# fresh on every `docker compose up` - these client_id/client_secret pairs
# are not real secrets, just fixtures baked into that file for local dev and
# for test/integration's client_credentials harness (see README.md, "Fluxo
# de autenticação"). provider-a and provider-b carry the realm role
# `provider` and a fixed `provider_id` claim; wallet-service carries
# `wallet-admin`; no-roles-client carries neither, for the 403 tests;
# provider-a-short-lived is provider-a in every way except a 2-second access
# token lifespan, for the 401-on-expiry test.
AUTH_TEST_PROVIDER_A_CLIENT_ID=provider-a
AUTH_TEST_PROVIDER_A_CLIENT_SECRET=provider-a-secret
AUTH_TEST_PROVIDER_B_CLIENT_ID=provider-b
AUTH_TEST_PROVIDER_B_CLIENT_SECRET=provider-b-secret
AUTH_TEST_WALLET_SERVICE_CLIENT_ID=wallet-service
AUTH_TEST_WALLET_SERVICE_CLIENT_SECRET=wallet-service-secret
AUTH_TEST_NO_ROLES_CLIENT_ID=no-roles-client
AUTH_TEST_NO_ROLES_CLIENT_SECRET=no-roles-secret
AUTH_TEST_SHORT_LIVED_CLIENT_ID=provider-a-short-lived
AUTH_TEST_SHORT_LIVED_CLIENT_SECRET=provider-a-short-lived-secret
