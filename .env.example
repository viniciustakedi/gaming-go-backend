# Copy to .env for local docker-compose overrides. No real secrets belong
# here - Postgres and MiniStack credentials below are throwaway local
# values, and the SQS role keys are generated fresh by the provisioning
# service on every `docker compose up` (see deploy/ministack/provision.sh
# and deploy/ministack/.runtime/app-credentials.env, git-ignored - see
# README.md for the split between that file and test-credentials.env).

POSTGRES_USER=wallet
POSTGRES_PASSWORD=wallet
POSTGRES_DB=wallet
POSTGRES_PORT=5432

MINISTACK_PORT=4566

SQS_REGION=us-east-1
SQS_INPUT_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_QUEUE_NAME=wager-transactions-dlq.fifo
SQS_OUTPUT_QUEUE_NAME=wallet-events.fifo
# Used only by deploy/ministack/provision.sh to create the queue RedrivePolicy;
# the Go service does not read this value.
WAGER_TRANSACTIONS_MAX_RECEIVE_COUNT=5
# The gateway publishes WagerTransactionRequested with MessageGroupId equal
# to walletId and MessageDeduplicationId equal to the envelope messageId.
# The consumer deletes only after its inbox+wallet transaction commits.
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_POLL_WAIT=20s
SQS_CONSUMER_CONCURRENCY=10
SQS_CONSUMER_VISIBILITY_TIMEOUT=30s
SQS_CONSUMER_PROCESSING_TIMEOUT=20s
SQS_CONSUMER_RETRY_BASE=1s
SQS_CONSUMER_RETRY_MAX=1m
SQS_CONSUMER_SHUTDOWN_TIMEOUT=30s
SQS_CONSUMER_PROVIDER_ALLOWLIST=provider-a,provider-b

# Durable retry worker for REFUND, ROLLBACK and referenced WIN that arrive
# before their reference. A short lease makes work recoverable by another
# instance after a crash; tests override all values with short durations.
REFERENCE_WORKER_ENABLED=true
REFERENCE_WORKER_POLL_INTERVAL=250ms
REFERENCE_WORKER_LEASE=30s
REFERENCE_WORKER_BATCH_SIZE=10
REFERENCE_WORKER_RETRY_BASE=1s
REFERENCE_WORKER_RETRY_MAX=1m
REFERENCE_WORKER_MAX_ATTEMPTS=10
REFERENCE_WORKER_TTL=24h
REFERENCE_WORKER_SHUTDOWN_TIMEOUT=5s

HTTP_PORT=8080
LOG_LEVEL=info

# Ports for the "multi" Compose profile's three instances (README.md,
# "Múltiplas instâncias") - unused by the single-instance `app` service
# above.
HTTP_PORT_1=8091
HTTP_PORT_2=8092
HTTP_PORT_3=8093

KEYCLOAK_PORT=8081
AUTH_AUDIENCE=wallet-api

# The knobs below are read directly by internal/config.Load (not through
# docker-compose's own variable substitution) and matter only when running
# `go run ./cmd/wallet-service serve` outside the Compose network, or when
# tuning a running container's environment: block. Every value here is the
# built-in default, so none of this needs to be set for `docker compose up`
# to work: docker-compose.yml's `app` service sets its own
# DATABASE_HOST/PORT/NAME/SSLMODE, SQS_ENDPOINT_URL and
# AUTH_ISSUER_URL/AUTH_DISCOVERY_URL directly in its `environment:` block
# (derived from POSTGRES_*/KEYCLOAK_PORT above), and none of those compose
# entries read a same-named variable from this file - the values below are
# only what a standalone `go run ./cmd/wallet-service serve` needs instead.

# HTTP server.
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_READINESS_TIMEOUT=3s
HTTP_SHUTDOWN_TIMEOUT=15s

# internal/config.Load builds the app's own Postgres DSN from just these
# four - never a password - then internal/pg.AppDSN adds wallet_app's
# credentials from DATABASE_APP_CREDENTIALS_FILE on top (README.md,
# "Credenciais do Postgres"). DATABASE_HOST/PORT/NAME below match this same
# file's POSTGRES_PORT/POSTGRES_DB for a host-side run; DATABASE_SSLMODE has
# a built-in default of "disable" so it is optional even standalone.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=wallet
DATABASE_SSLMODE=disable
# Session GUCs (spec: "as sessões Postgres usam lock_timeout e
# statement_timeout, e estourar qualquer um deles é falha transitória").
DATABASE_PING_TIMEOUT=5s
DATABASE_LOCK_TIMEOUT=3s
DATABASE_STATEMENT_TIMEOUT=5s
DATABASE_APP_CREDENTIALS_FILE=deploy/postgres/.runtime/credentials.env

# Where the SQS client discovers queue URLs and how long it waits for them
# and for the Postgres ping above before start fails fast.
SQS_STARTUP_TIMEOUT=10s
# IAM_CREDENTIALS_FILE is read by deploy/docker/entrypoint.sh, not by the Go
# process directly - see README.md, "Variáveis de ambiente".
IAM_CREDENTIALS_FILE=/shared/app-credentials.env

# Outbox publisher (transactional outbox → wallet-events.fifo).
OUTBOX_POLL_INTERVAL=250ms
OUTBOX_LEASE=30s
OUTBOX_BATCH_SIZE=10
OUTBOX_RETRY_BASE=1s
OUTBOX_RETRY_MAX=1m

# OIDC validation (internal/auth). AUTH_ISSUER_URL is the exact "iss" every
# accepted token must carry; AUTH_DISCOVERY_URL is only where this process
# fetches OIDC/JWKS metadata from, and defaults to AUTH_ISSUER_URL when
# unset - see README.md, "Autenticação e autorização" for why the two
# differ inside Compose. Neither has a literal default in code (both are
# required), so the values below are what a host-side run (matching
# KC_HOSTNAME) or the Compose app container (matching the internal
# `keycloak` service name) would set.
AUTH_ISSUER_URL=http://localhost:8081/realms/wallet
AUTH_DISCOVERY_URL=http://localhost:8081/realms/wallet
AUTH_CLOCK_SKEW=5s
AUTH_DISCOVERY_TIMEOUT=45s

# Upper bound Fx.Stop is allowed; must exceed the sum of every component's
# own shutdown budget above and below (internal/config validates this at
# start - "FX_STOP_TIMEOUT must be greater than the sum of internal stop
# deadlines").
FX_STOP_TIMEOUT=60s

# Keycloak realm "wallet" (deploy/keycloak/realm-wallet.json) is imported
# fresh on every `docker compose up` - these client_id/client_secret pairs
# are not real secrets, just fixtures baked into that file for local dev and
# for test/integration's client_credentials harness (see README.md, "Fluxo
# de autenticação"). provider-a and provider-b carry the realm role
# `provider` and a fixed `provider_id` claim; wallet-service carries
# `wallet-admin`; no-roles-client carries neither, for the 403 tests;
# provider-a-short-lived is provider-a in every way except a 2-second access
# token lifespan, for the 401-on-expiry test.
AUTH_TEST_PROVIDER_A_CLIENT_ID=provider-a
AUTH_TEST_PROVIDER_A_CLIENT_SECRET=provider-a-secret
AUTH_TEST_PROVIDER_B_CLIENT_ID=provider-b
AUTH_TEST_PROVIDER_B_CLIENT_SECRET=provider-b-secret
AUTH_TEST_WALLET_SERVICE_CLIENT_ID=wallet-service
AUTH_TEST_WALLET_SERVICE_CLIENT_SECRET=wallet-service-secret
AUTH_TEST_NO_ROLES_CLIENT_ID=no-roles-client
AUTH_TEST_NO_ROLES_CLIENT_SECRET=no-roles-secret
AUTH_TEST_SHORT_LIVED_CLIENT_ID=provider-a-short-lived
AUTH_TEST_SHORT_LIVED_CLIENT_SECRET=provider-a-short-lived-secret
